# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
*.whl

# ─── Node / frontend build ───────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ─── Local cache / runtime output ────────────────────────────────────────────
# The console writes scan results, discovery dumps, and checkpoints here.
frontend/cache/*
!frontend/cache/.gitignore

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# ─── IdC-to-AAM tool: extra Python caches ────────────────────────────────────
env/
*$py.class
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ─── IdC-to-AAM tool: test / coverage artifacts ──────────────────────────────
.coverage
coverage.xml
htmlcov/
build/

# ─── IdC-to-AAM tool: generated outputs ──────────────────────────────────────
inventory_*.json
migration_plan_*.xlsx
mapping_*.xlsx
mapping_*.csv
mapping_*.json
audit_*.csv
# Generated IaC (CloudFormation templates with real ARNs / entitlements)
Identity Center to AAM/output/
output/

# ─── IdC-to-AAM tool: all generated Excel outputs + Office lock files ─────────
# Every .xlsx the tool touches is generated (migration plans, mapping reports)
# and contains customer-specific data — never commit them.
*.xlsx
~$*
