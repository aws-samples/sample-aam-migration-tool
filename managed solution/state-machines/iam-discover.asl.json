{
  "Comment": "Truffle IAM Federation Discovery — discovers SAML-federated roles across accounts with per-account IDP filtering.",
  "StartAt": "UpdateProgressStarted",
  "States": {
    "UpdateProgressStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${JobsTableName}",
        "Key": {
          "PK": { "S.$": "States.Format('CALLER#{}', $.caller_arn)" },
          "SK": { "S.$": "States.Format('JOB#{}', $.job_id)" }
        },
        "UpdateExpression": "SET progress = :p",
        "ExpressionAttributeValues": {
          ":p": {
            "M": {
              "completed_units": { "N": "0" },
              "total_units": { "N": "0" },
              "message": { "S": "Discovering federated roles" }
            }
          }
        }
      },
      "ResultPath": null,
      "Next": "MapAccounts"
    },
    "MapAccounts": {
      "Type": "Map",
      "ItemsPath": "$.discover_targets",
      "MaxConcurrency": 10,
      "Parameters": {
        "account_id.$": "$$.Map.Item.Value.account_id",
        "idp_arns.$": "$$.Map.Item.Value.idp_arns",
        "job_id.$": "$.job_id",
        "caller_arn.$": "$.caller_arn"
      },
      "Iterator": {
        "StartAt": "DiscoverRoles",
        "States": {
          "DiscoverRoles": {
            "Type": "Task",
            "Resource": "${DiscoverRolesFnArn}",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.TooManyRequestsException", "States.TaskFailed"],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              },
              {
                "ErrorEquals": ["States.Timeout"],
                "IntervalSeconds": 30,
                "MaxAttempts": 2,
                "BackoffRate": 1.5
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "DiscoverFailed"
              }
            ],
            "End": true
          },
          "DiscoverFailed": {
            "Type": "Pass",
            "Parameters": {
              "account_id.$": "$.account_id",
              "roles": [],
              "roles_scanned": 0,
              "roles_found": 0,
              "status": "error",
              "error.$": "$.error"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.discover_results",
      "Next": "Aggregate"
    },
    "Aggregate": {
      "Type": "Task",
      "Resource": "${AggregateFnArn}",
      "Parameters": {
        "job_id.$": "$.job_id",
        "caller_arn.$": "$.caller_arn",
        "job_type.$": "$.job_type",
        "results.$": "$.discover_results",
        "params": {
          "idp_filter.$": "$.idp_filter",
          "discover_targets.$": "$.discover_targets"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "End": true
    }
  }
}
