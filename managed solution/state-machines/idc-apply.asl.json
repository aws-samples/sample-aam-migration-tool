{
  "Comment": "Truffle IdC Apply — creates IAM roles and AAM entitlements for each permission set + account pair.",
  "StartAt": "UpdateProgressStarted",
  "States": {
    "UpdateProgressStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${JobsTableName}",
        "Key": {
          "PK": { "S.$": "States.Format('CALLER#{}', $.caller_arn)" },
          "SK": { "S.$": "States.Format('JOB#{}', $.job_id)" }
        },
        "UpdateExpression": "SET progress = :p",
        "ExpressionAttributeValues": {
          ":p": {
            "M": {
              "completed_units": { "N": "0" },
              "total_units": { "N": "0" },
              "message": { "S": "Creating roles and entitlements" }
            }
          }
        }
      },
      "ResultPath": null,
      "Next": "MapPairs"
    },
    "MapPairs": {
      "Type": "Map",
      "ItemsPath": "$.pairs",
      "MaxConcurrency": 5,
      "Parameters": {
        "permission_set.$": "$$.Map.Item.Value.permission_set",
        "account_id.$": "$$.Map.Item.Value.account_id",
        "assignments.$": "$$.Map.Item.Value.assignments",
        "role_path.$": "$.role_path",
        "role_name_template.$": "$.role_name_template",
        "aam_application_arn.$": "$.aam_application_arn",
        "hub_account_id.$": "$.hub_account_id",
        "aam_region.$": "$.aam_region",
        "job_id.$": "$.job_id",
        "caller_arn.$": "$.caller_arn"
      },
      "Iterator": {
        "StartAt": "ApplyRole",
        "States": {
          "ApplyRole": {
            "Type": "Task",
            "Resource": "${IdcApplyFnArn}",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.TooManyRequestsException"],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "ApplyFailed"
              }
            ],
            "End": true
          },
          "ApplyFailed": {
            "Type": "Pass",
            "Parameters": {
              "role_name": "unknown",
              "role_arn": "",
              "account_id.$": "$.account_id",
              "permission_set.$": "$.permission_set.name",
              "status": "error",
              "error.$": "$.error",
              "entitlements": []
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.apply_results",
      "Next": "Aggregate"
    },
    "Aggregate": {
      "Type": "Task",
      "Resource": "${AggregateFnArn}",
      "Parameters": {
        "job_id.$": "$.job_id",
        "caller_arn.$": "$.caller_arn",
        "job_type": "idc-apply",
        "results.$": "$.apply_results",
        "params": {
          "role_path.$": "$.role_path",
          "role_name_template.$": "$.role_name_template",
          "aam_application_arn.$": "$.aam_application_arn"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "MarkFailed",
          "ResultPath": "$.error"
        }
      ],
      "End": true
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${JobsTableName}",
        "Key": {
          "PK": { "S.$": "States.Format('CALLER#{}', $.caller_arn)" },
          "SK": { "S.$": "States.Format('JOB#{}', $.job_id)" }
        },
        "UpdateExpression": "SET #s = :s, #e = :e",
        "ExpressionAttributeNames": {
          "#s": "status",
          "#e": "error"
        },
        "ExpressionAttributeValues": {
          ":s": { "S": "error" },
          ":e": { "S.$": "States.Format('IdC apply failed: {}', $.error.Cause)" }
        }
      },
      "End": true
    }
  }
}
