{
  "Comment": "Truffle IAM Migration — updates trust policies on selected roles to add/replace AAM trust.",
  "StartAt": "UpdateProgressStarted",
  "States": {
    "UpdateProgressStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${JobsTableName}",
        "Key": {
          "PK": { "S.$": "States.Format('CALLER#{}', $.caller_arn)" },
          "SK": { "S.$": "States.Format('JOB#{}', $.job_id)" }
        },
        "UpdateExpression": "SET progress = :p",
        "ExpressionAttributeValues": {
          ":p": {
            "M": {
              "completed_units": { "N": "0" },
              "total_units": { "N": "0" },
              "message": { "S": "Migrating trust policies" }
            }
          }
        }
      },
      "ResultPath": null,
      "Next": "MapRoles"
    },
    "MapRoles": {
      "Type": "Map",
      "ItemsPath": "$.role_arns",
      "MaxConcurrency": 5,
      "Parameters": {
        "role_arn.$": "$$.Map.Item.Value",
        "mode.$": "$.mode",
        "idp_arn.$": "$.idp_arn",
        "job_id.$": "$.job_id",
        "caller_arn.$": "$.caller_arn"
      },
      "Iterator": {
        "StartAt": "MigrateRole",
        "States": {
          "MigrateRole": {
            "Type": "Task",
            "Resource": "${MigrateRoleFnArn}",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.TooManyRequestsException"],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "MigrateFailed"
              }
            ],
            "End": true
          },
          "MigrateFailed": {
            "Type": "Pass",
            "Parameters": {
              "role_arn.$": "$.role_arn",
              "role_name": "unknown",
              "status": "error",
              "mode.$": "$.mode",
              "error.$": "$.error"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.migrate_results",
      "Next": "Aggregate"
    },
    "Aggregate": {
      "Type": "Task",
      "Resource": "${AggregateFnArn}",
      "Parameters": {
        "job_id.$": "$.job_id",
        "caller_arn.$": "$.caller_arn",
        "job_type": "iam-migrate",
        "results.$": "$.migrate_results",
        "params": {
          "mode.$": "$.mode",
          "idp_arn.$": "$.idp_arn",
          "role_arns.$": "$.role_arns"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "End": true
    }
  }
}
